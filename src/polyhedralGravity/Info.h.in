#pragma once

#include <string_view>

// ##########################################################################################
// Please note! The content of this file is automatically modified by the CMake build system
// which replaces the variables
// ##########################################################################################

namespace polyhedralGravity {

    /**
     * The API's version of the polyhedral gravity model's interface.
     * The value is set by the CMake configuration.
     */
    constexpr std::string_view POLYHEDRAL_GRAVITY_VERSION = "@POLYHEDRAL_GRAVITY_VERSION@";

    /**
     * The commit hash of the currently compiled version.
     * This is appended with '+modified' in case the working tree is not clean.
     * The value is set by the CMake configuration.
     */
    constexpr std::string_view POLYHEDRAL_GRAVITY_COMMIT_HASH = "@POLYHEDRAL_GRAVITY_COMMIT_HASH@";

    /**
     * The API's Logging Level. Determines the amount of output.
     * The value is set by the CMake configuration.
     */
    constexpr std::string_view POLYHEDRAL_GRAVITY_LOGGING_LEVEL = "@POLYHEDRAL_GRAVITY_LOGGING_LEVEL@";

    /**
     * The compiler which translated the host code, e.g. @code "GNU 13.2.0" @endcode.
     * The value is set by the CMake configuration.
     */
    constexpr std::string_view POLYHEDRAL_GRAVITY_HOST_COMPILER = "@POLYHEDRAL_GRAVITY_HOST_COMPILER@";

    /**
     * The compiler which translated the device code, e.g. @code "NVIDIA nvcc 12.4" @endcode.
     * This is @code "None" @endcode if the library was compiled without a GPU backend.
     * The value is set by the CMake configuration.
     */
    constexpr std::string_view POLYHEDRAL_GRAVITY_DEVICE_COMPILER = "@POLYHEDRAL_GRAVITY_DEVICE_COMPILER@";

    /**
     * Whether the library was compiled with fast, less accurate floating point arithmetic, i.e. with the
     * CMake option @code POLYHEDRAL_GRAVITY_FAST_MATH @endcode.
     *
     * This only ever concerns {@link ComputePrecision::FLOAT32}: the compilers' fast math flags have no fast
     * path for double precision, so {@link ComputePrecision::FLOAT64} is bit-identical either way.
     * The value is set by the CMake configuration.
     */
    constexpr bool POLYHEDRAL_GRAVITY_FAST_MATH = @POLYHEDRAL_GRAVITY_FAST_MATH_LITERAL@;

}// namespace polyhedralGravity
